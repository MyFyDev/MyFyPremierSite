{
  "name": "myfypremiersite",
  "version": "1.0.0",
  "description": "MyFy Premier marketing site — static file server",
  "author": "Daniel Cox",
  "private": true,
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "./node_modules/.bin/dotenvx run -- node server.js",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "postinstall": "git config core.hooksPath ./node_modules/utilities/hooks || true"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.19.0",
    "utilities": "github:MyFyDev/utilities#f34c82e2301daa66f9053257202340f6c26bc35b"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
